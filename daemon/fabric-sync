#!/usr/bin/env python3
"""fabric-sync — mirror every fabric peer's PipeWire devices as local tunnels (event-driven).

One per-node systemd service. Peers are declared by nixaudio and re-read from the generated config on
every discovery pass, so a peer added to the fleet joins without restarting this daemon (see
fabric_nodes). Every device of every fabric peer appears locally as a tunnel — both sink and source,
every direction.

WORKS EVERYWHERE: tunnels run on every node, home or roaming. Two safeguards keep a stalled remote
tunnel from wedging this node's LOCAL audio (the 2026-06-18 incident): (1) ISOLATION — every tunnel is
pinned to its OWN pipewire data-loop `fabric-loop.0` (via node.loop.name + a 2-loop pipewire.conf.d
drop-in), so a stalled tunnel disrupts only that loop, not the hardware loop where local apps live;
(2) SELF-HEAL — if the local pulse server is unresponsive for ~3 ticks, the daemon restarts the audio
stack to recover automatically (a wedge no longer needs a manual restart). A fully unreachable peer
also has its tunnels dropped by the discovery probe. NOTE: WAN audio DELIVERY (actually hearing audio
while roaming) needs an overlay MTU/PMTUD fix — see modules/nixos/audio-fabric/README.md. The fix
mechanism (isolation) was validated as a MECHANISM but NOT against the real roam-transition wedge (it
couldn't be reproduced from home); the next roam is the live proof, with self-heal as the backstop.

EVENT-DRIVEN: one long-lived `pactl -s tcp:<peer>:4713 subscribe` per peer reacts to remote device
add/remove instantly (no polling load). A slow 60s pass only re-probes the fabric nodes for reachability
(LAN membership can't be subscribed to — see fabric_peers). Audio rides the native-protocol-tcp:4713
path (network-gated; the cookie does NOT authenticate — see SECURITY NOTE below); no new network layer.

Robust by design: data-loop isolation + self-heal (above); dead watch-threads are reaped + respawned;
reconciler exceptions are caught; a 60s heartbeat logs liveness (watching N peers, tunnels=M).
Invariants: loop-guard (never mirror tunnel.*/fabric*/.monitor); idempotent deterministic names.

SECURITY NOTE: the pulse cookie does NOT authenticate on PipeWire 1.6.x — verified that a no-cookie or
wrong-cookie client gets full read + module-load over :4713 (auth-anonymous=0 is a no-op in
module-native-protocol-tcp). Access control is the NETWORK layer only (the LAN + per-node firewall — the
fabric is LAN-scoped). See modules/nixos/audio-fabric/README.md (Known gaps); firewall hardening pending.
"""
import json, subprocess, hashlib, time, os, socket, threading

# ── CONFIG (nixaudio) ───────────────────────────────────────────────────────────────────────────
# Everything host-specific is read from a generated JSON file instead of being edited into this
# source. That is the whole point of moving the daemon into nixaudio: the peer set is derived from
# nixnet's declared peers, so a host joining the fleet joins the audio pool, and a roaming host is
# addressed by a NAME whose current address nixnet keeps pointed at whichever transport is healthy.
#
# The logic below this block is unchanged from the original hand-deployed daemon on purpose -- it is
# load-bearing and proven in production (debounce, loop-guard, idempotent naming, self-heal), so the
# migration to declarative config deliberately touches the CONFIG SURFACE and nothing else.
_CFG_PATH = os.environ.get("NIXAUDIO_FABRIC_CONFIG", "/etc/nixaudio/fabric.json")
try:
    with open(_CFG_PATH) as _f:
        _CFG = json.load(_f)
except FileNotFoundError:
    raise SystemExit(
        f"fabric-sync: no config at {_CFG_PATH}. This daemon is configured declaratively by "
        f"nixaudio; set NIXAUDIO_FABRIC_CONFIG or enable nixaudio.fabric on this host."
    )

PORT = _CFG.get("port", 4713)
PROBE_TIMEOUT = 0.8
TICK = 15                    # main-loop cadence (peer discovery is rate-limited to DISCOVER_EVERY)
DISCOVER_EVERY = 60          # the peer-discovery pass (reachability probes on the LAN) waits this long
SETTLE = 1.5                 # seconds to let a device-change burst settle before the trailing reconcile
TIMEOUT = 6
FABRIC_LOOP = _CFG.get("loop", "fabric-loop.0")  # tunnels are pinned to this own data-loop so a stall can't wedge hardware audio
MIRROR_PRIORITY = _CFG.get("mirrorPriority", 0)  # a mirror must lose the default-sink race to real local hardware
HEAL_FAILS = 3               # consecutive unresponsive-pulse ticks before self-heal restarts the audio stack
HEAL_COOLDOWN = 300          # min seconds between self-heal restarts (anti-flap)


def run(args, timeout=10):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except Exception:
        class R: returncode = 1; stdout = ""; stderr = ""
        return R()


def log(*a):
    print("fabric-sync:", *a, flush=True)


# ── Fabric membership — a small, fixed set of nodes on the home LAN, addressed by their stable LAN IPs.
#    The fabric carries audio ONLY on the LAN: over a VPN overlay (cellular/WAN) the sustained native-
#    protocol stream starves — an unsolved PMTUD/MTU problem, see README — so there is nothing to gain by
#    routing discovery through an overlay, and not every node necessarily runs an overlay client of its own anyway. So:
#    plain LAN. Discovery is pure REACHABILITY — probe each node's :4713 on the LAN and mirror whoever
#    answers; a roaming laptop simply drops out until it is home. Add a fabric node = one line here.
# Peers come from nixaudio.fabric.peers, which itself defaults to nixnet's declared peer set.
# Keys are whatever the peer is REACHED at (prefer a nixnet-published name over a raw address);
# values are the display name. Self is skipped by the existing local-IP / hostname match below.
#
# RE-READ, not frozen at import. The peer table is the one part of this config that genuinely
# changes under a running daemon: the fleet gains a host, and the generated config is rewritten by
# the next switch. Nothing restarts this unit when that happens -- switch-to-configuration does not
# restart running `systemd --user` services, and the unit file is byte-identical anyway, since only
# the file it POINTS AT changed. A table captured at import therefore stays wrong indefinitely,
# while the daemon reports itself healthy: `systemctl status` says active, the config on disk is
# correct, and the two silently disagree. That is exactly the class of quiet drift this daemon was
# moved into nixaudio to end, so discovery reads the file rather than a snapshot of it.
#
# Only the PEER TABLE is refreshed. PORT and FABRIC_LOOP stay as read at startup: every loaded
# tunnel carries both baked into its module arguments, so changing them live would mean tearing
# down and rebuilding every tunnel on the host. They are also the two values that do not move in
# practice. A change to either needs a restart, and says so here rather than half-applying.
_PEERS = _CFG.get("peers", {})
_CFG_ERROR = None


def fabric_nodes():
    """The peer table, re-read from the config file. Returns the last known-good table if the file
    cannot be read or parsed -- a half-written or briefly-missing config must not collapse the peer
    set to empty, because an empty set reads as 'every peer left the fabric' and would unload every
    tunnel on the host over a transient."""
    global _PEERS, _CFG_ERROR
    try:
        with open(_CFG_PATH) as f:
            fresh = json.load(f).get("peers", {})
    except Exception as e:
        if str(e) != _CFG_ERROR:
            _CFG_ERROR = str(e)
            log(f"config {_CFG_PATH} unreadable ({e}) — keeping the last known-good peer table")
        return _PEERS
    _CFG_ERROR = None
    if fresh != _PEERS:
        changed = ([f"+{p}" for p in sorted(set(fresh) - set(_PEERS))]
                   + [f"-{p}" for p in sorted(set(_PEERS) - set(fresh))])
        # A change with no key difference is a renamed peer -- still worth one line, since it moves
        # every one of that peer's tunnel labels on the next reconcile.
        log("peer table changed: " + (", ".join(changed) if changed else "peer names updated"))
        _PEERS = fresh
    return _PEERS


def self_ips():
    """Local IPv4 addresses — used to skip ourselves (both fabric nodes' LAN IPs are local interfaces)."""
    r = run(["ip", "-o", "-4", "addr", "show"], timeout=4)
    out = set()
    for ln in r.stdout.splitlines():
        f = ln.split()
        if len(f) > 3 and "/" in f[3]:
            out.add(f[3].split("/")[0])
    return out


def fabric_peers():
    """{ip: hostname} of the OTHER fabric nodes currently reachable on :4713 over the LAN. Always returns
    (dict, True): the candidate list is static, so 'discovery' can't fail — an unreachable node is simply
    absent (its tunnels get dropped) and re-appears when it answers again. Self is skipped by local-IP
    match (both nodes' LAN IPs are local interfaces) with a hostname fallback."""
    selfips = self_ips()
    selfhost = socket.gethostname().lower()
    out = {}
    for ip, host in fabric_nodes().items():
        if ip in selfips or host.lower() == selfhost:
            continue
        try:
            socket.create_connection((ip, PORT), timeout=PROBE_TIMEOUT).close()
            out[ip] = host
        except Exception:
            pass
    return out, True


def pactl(args, server=None):
    cmd = ["pactl"] + (["-s", f"tcp:{server}:{PORT}"] if server else []) + args
    return run(cmd, timeout=TIMEOUT)


def remote_devices(server, kind):
    r = pactl(["list", kind], server=server)
    if r.returncode != 0:
        return None
    devs, name, desc = [], None, None
    for line in r.stdout.splitlines():
        s = line.strip()
        if s.startswith("Name:"):
            if name is not None:
                devs.append((name, desc or name))
            name = s.split(":", 1)[1].strip(); desc = None
        elif s.startswith("Description:") and name is not None and desc is None:
            desc = s.split(":", 1)[1].strip()
    if name is not None:
        devs.append((name, desc or name))
    return devs


def loaded_fabric(prefix=None):
    """{local_name: module_id} for fabric_*/fabricsrc_* tunnels (optionally only one peer's prefix)."""
    out = {}
    r = pactl(["list", "short", "modules"])
    for line in r.stdout.splitlines():
        f = line.split("\t")
        if len(f) < 3 or f[1] not in ("module-tunnel-sink", "module-tunnel-source"):
            continue
        for a in f[2].split():
            if a.startswith(("sink_name=fabric", "source_name=fabric")):
                nm = a.split("=", 1)[1]
                if prefix is None or nm.startswith(prefix):
                    out[nm] = f[0]
    return out


def skip(name):
    return (not name) or name.startswith(("tunnel.", "fabric_", "fabricsrc_")) or name.endswith(".monitor")


def tok(prefix, last, name):
    return f"{prefix}_{last}_{hashlib.md5(name.encode()).hexdigest()[:10]}"


def reconcile_peer(ip, host):
    """Mirror exactly this peer's current device set onto local tunnels: load tunnels for new remote
    devices, unload this peer's tunnels whose remote device is gone. Idempotent — safe to call
    repeatedly; watch()'s reconciler debounces the calls (leading + trailing edge)."""
    last = ip.rsplit(".", 1)[-1]
    sinks = remote_devices(ip, "sinks")
    if sinks is None:
        return  # peer momentarily unreachable; subscribe loop / next discover handles it
    sources = remote_devices(ip, "sources") or []
    want = {}
    for name, desc in sinks:
        if skip(name):
            continue
        want[tok("fabric", last, name)] = ("sink", name, f"{host} {desc}".replace(" ", "_"))
    for name, desc in sources:
        if skip(name):
            continue
        want[tok("fabricsrc", last, name)] = ("source", name, f"{host} mic {desc}".replace(" ", "_"))
    have = loaded_fabric(prefix=None)
    for lname, (kind, dev, label) in want.items():
        if lname in have:
            continue
        mod = "module-tunnel-sink" if kind == "sink" else "module-tunnel-source"
        key = "sink" if kind == "sink" else "source"
        # Two properties, and the QUOTES INSIDE THE VALUE are load-bearing:
        #
        #   {key}_properties="a=1 b=2"   both parse
        #   {key}_properties=a=1 b=2     only `a` parses, `b` is silently dropped
        #   {key}_properties={a=1 b=2}   neither parses; the whole value is silently ignored
        #
        # Measured against a live pipewire-pulse, not assumed -- the unquoted form is what this
        # daemon used to send, which is why only the first property ever took effect.
        #
        #   node.loop.name    pins the tunnel to its own data-loop so a stalled remote cannot wedge
        #                     the loop local hardware audio runs on.
        #   priority.session  makes a MIRROR lose the default-sink race to real local hardware. This
        #                     used to be attempted from a WirePlumber `stream.rules` fragment and
        #                     never worked: these tunnels are created by pipewire-pulse, not by a
        #                     WirePlumber monitor, so no monitor rule is ever evaluated against
        #                     them, and `stream.rules` governs streams rather than sink nodes. Set
        #                     at creation it lands -- verified with pw-dump.
        props = f"{key}_properties=\"node.loop.name={FABRIC_LOOP} priority.session={MIRROR_PRIORITY}\""
        pactl(["load-module", mod, f"server=tcp:{ip}:{PORT}", f"{key}={dev}",
               f"{key}_name={lname}", "reconnect_interval_ms=15000", props])
        log(f"+ {lname} ({label})")
    # unload only THIS peer's stale tunnels (peer enumerated OK -> vanished devices are truly gone)
    for lname, mid in loaded_fabric(prefix="fabric").items():
        p = lname.split("_")
        if len(p) > 2 and p[1] == last and lname not in want:
            if pactl(["unload-module", mid]).returncode == 0:
                log(f"- {lname}")


def watch(ip, host, stop):
    """Per-peer thread. Holds a long-lived `pactl subscribe` and reconciles on the peer's device
    events. A dedicated reconciler applies LEADING + TRAILING edge debouncing: it reacts at once (fast
    add) and then reconciles again once the event burst goes quiet (reliable remove — by then pulse has
    finished tearing the device down, and a remove that lands right after an add can never be dropped).
    Purely event-driven: a reconcile happens only in response to a subscribe event, never on a timer."""
    log(f"watch {host} ({ip})")
    try:
        reconcile_peer(ip, host)        # initial full sync
    except Exception as e:
        log(f"initial reconcile {host} error: {e}")
    dirty = threading.Event()

    def reconciler():
        while not stop.is_set():
            if not dirty.wait(timeout=1):
                continue
            dirty.clear()
            try:
                reconcile_peer(ip, host)      # leading edge: react immediately (fast add)
                time.sleep(SETTLE)            # let the event burst settle
                if not dirty.is_set():
                    reconcile_peer(ip, host)  # trailing edge: settled state (reliable remove)
            except Exception as e:
                log(f"reconcile {host} error: {e}"); time.sleep(2)
            # if more events arrived during SETTLE, dirty is set -> the loop reconciles again
    rt = threading.Thread(target=reconciler, daemon=True)
    rt.start()

    while not stop.is_set():
        try:
            p = subprocess.Popen(["pactl", "-s", f"tcp:{ip}:{PORT}", "subscribe"],
                                 stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        except Exception:
            time.sleep(5); continue
        try:
            for line in p.stdout:
                if stop.is_set():
                    break
                if any(k in line for k in ("sink", "source", "server", "card")):
                    dirty.set()
        except Exception:
            pass
        finally:
            try: p.terminate()
            except Exception: pass
        if not stop.is_set():
            dirty.set()    # subscribe dropped (peer roam/restart) -> resync to catch missed events
            time.sleep(5)  # back off, then re-subscribe
    log(f"unwatch {host} ({ip})")


def unload_peer(ip):
    last = ip.rsplit(".", 1)[-1]
    for lname, mid in loaded_fabric(prefix="fabric").items():
        p = lname.split("_")
        if len(p) > 2 and p[1] == last:
            pactl(["unload-module", mid]); log(f"- {lname} (peer gone)")


def pulse_alive():
    """Cheap local liveness probe: does pipewire-pulse answer pactl within a few seconds?

    DELIBERATELY NOT A GRAPH-HEALTH CHECK, and this needs saying because the obvious "improvement"
    is to make it one. During the 2026-08-11 outage this probe answered YES for 1h45m while the
    graph had zero ALSA devices -- pipewire-pulse was perfectly responsive, it simply had nothing to
    offer -- so `fails` reset every tick and heal() never fired again after the restart that caused
    the damage.

    The fix for that is NOT here. This daemon has no business deciding what a healthy device set
    looks like: on one host in this estate the correct steady state is three ALSA devices for four
    kernel cards, and on another a card is disabled on purpose. `nixaudio.guard` owns that predicate,
    runs on every wireplumber start, and therefore also covers the restart heal() issues -- so
    duplicating it here would add a second, worse copy of a rule that has to be right.

    What this probe is for is narrower and still correct: is the local pulse layer answering at all.
    """
    return run(["pactl", "info"], timeout=4).returncode == 0


def heal(watchers):
    """Self-heal a wedged local pulse by restarting ONE unit: pipewire.service.

    THIS FUNCTION CAUSED A 1h45m TOTAL AUDIO OUTAGE. It used to name all three units --
    `systemctl --user restart pipewire pipewire-pulse wireplumber` -- and that is what broke the
    graph, so the change here is the fix for the incident, not a tidy-up.

    Naming three units asks systemd for three independent restart jobs and throws away the ordering
    the vendor units already declare. Both pipewire-pulse.service and wireplumber.service carry
    `BindsTo=pipewire.service` and `After=pipewire.service`, and wireplumber is `WantedBy=
    pipewire.service`. Restarting pipewire.service ALONE therefore stops the other two first (the
    reverse of After=), restarts the daemon, and pulls them back up in order -- one job, correct
    sequence, no overlap. That is what the unit graph is for.

    WHAT THE THREE-UNIT FORM DID INSTEAD. On 2026-08-11 a system-wide btrfs transaction stall put
    wireplumber into uninterruptible D state inside its own state-file save (the orphaned zero-byte
    `~/.local/state/wireplumber/*.<tmp>` files are the fingerprint, and there are ~19 of them going
    back weeks -- this stall is routine, not exotic). `pactl info` stopped answering, three ticks
    later this function fired, and systemd could not kill the old wireplumber: a task in D state
    never reaches signal delivery, so SIGKILL was queued twice and ignored. After 40s systemd gave
    up, logged `Found left-over process ... Ignoring`, and started a SECOND wireplumber while the
    first still held the ALSA cards -- and, decisively, still owned every
    org.freedesktop.ReserveDevice1.AudioN name. The new instance asked for those reservations, the
    frozen owner never answered RequestRelease, the acquire transition timed out into BUSY, and
    WirePlumber's ALSA monitor therefore never called createDevice for a single card. Zero ALSA
    devices, for 1h45m, until a human restarted wireplumber by hand.

    No systemd setting fixes that: SIGKILL is already the final signal, D state ignores it, and
    there is no option that makes a unit refuse to start while its cgroup is non-empty (that log
    line is advisory only). `TimeoutStopSec=infinity` would turn a degraded stack into an
    indefinite one. So the answer is not to kill harder -- it is to issue ONE job that systemd can
    sequence, and to have `nixaudio.guard` notice and repair the deviceless graph that
    results when even that is not enough. The restart is one half of the recovery; the guard is the
    half that checks the recovery worked.

    The daemon is a separate user service, so it survives the restart; it drops its stale watchers
    here and re-mirrors on the next tick."""
    log("local pulse unresponsive — self-heal: restarting pipewire.service (pulse + wireplumber follow)")
    run(["systemctl", "--user", "restart", "pipewire.service"], timeout=25)
    for ip in list(watchers):
        watchers[ip][1].set()
    watchers.clear()


def main():
    log("started (works-everywhere; isolated on %s; tick %ds, discover %ds)" % (FABRIC_LOOP, TICK, DISCOVER_EVERY))
    watchers = {}            # ip -> (thread, stop_event)
    last_discover = 0.0
    fails = 0               # consecutive unresponsive-pulse ticks
    last_heal = 0.0
    while True:
        # self-heal: a wedged local pulse (e.g. a roam-transition stall isolation didn't catch) recovers
        # automatically after HEAL_FAILS ticks, instead of staying dead until a human restarts it.
        if pulse_alive():
            fails = 0
        else:
            fails += 1
            if fails >= HEAL_FAILS and time.time() - last_heal > HEAL_COOLDOWN:
                heal(watchers); last_heal = time.time(); fails = 0; last_discover = 0.0
            time.sleep(TICK); continue
        # reap dead watch threads (a crashed watcher must not strand its peer)
        reaped = False
        for ip in list(watchers):
            if not watchers[ip][0].is_alive():
                log(f"watch thread for {ip} died -> respawning"); del watchers[ip]; reaped = True
        if reaped or time.time() - last_discover >= DISCOVER_EVERY:
            last_discover = time.time()
            fabric, ok = fabric_peers()
            if ok:
                for ip, host in fabric.items():
                    if ip not in watchers:
                        stop = threading.Event()
                        t = threading.Thread(target=watch, args=(ip, host, stop), daemon=True)
                        watchers[ip] = (t, stop); t.start()
                for ip in list(watchers):
                    if ip not in fabric:  # peer unreachable/left the LAN -> stop + drop its tunnels
                        watchers[ip][1].set(); del watchers[ip]; unload_peer(ip)
                log(f"alive: watching {len(watchers)} peer(s), tunnels={len(loaded_fabric())}")
            # else: fabric_peers now always returns ok=True (static candidate list) — branch kept defensively
        time.sleep(TICK)


if __name__ == "__main__":
    main()
